{
    "name": "keyhold-backend",
    "version": "0.0.1",
    "description": "Keyhold — peer-to-peer property marketplace API",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "postinstall": "prisma generate",
        "build": "prisma generate && nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "format": "prettier --write .",
        "lint": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "db:reseed": "tsx prisma/seed.ts --reset",
        "db:purge": "tsx prisma/purge.ts",
        "db:setup": "prisma db push && tsx prisma/seed.ts --reset"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.2.6",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@prisma/config": "^7.8.0",
        "@sendgrid/mail": "^7.7.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cloudinary": "^1.41.0",
        "multer": "^2.1.1",
        "nodemailer": "^6.9.7",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdfkit": "^0.13.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sendgrid": "^5.2.3",
        "stripe": "^14.9.0",
        "swagger-ui-express": "^5.0.1",
        "twilio": "^4.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@faker-js/faker": "^10.4.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.1.0",
        "@types/node": "^24.0.0",
        "@types/nodemailer": "^6.4.14",
        "@types/passport-jwt": "^4.0.1",
        "@types/pdfkit": "^0.12.11",
        "@types/supertest": "^7.0.0",
        "dotenv": "^17.4.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "jest": "^30.0.0",
        "prettier": "^3.4.2",
        "prisma": "^7.8.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.12",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "moduleNameMapper": {
            "^@core/(.*)$": "<rootDir>/modules/core/$1",
            "^@modules/(.*)$": "<rootDir>/modules/$1",
            "^@common/(.*)$": "<rootDir>/common/$1",
            "^@prisma-db/(.*)$": "<rootDir>/common/database/$1",
            "^@generated/(.*)$": "<rootDir>/../generated/$1",
            "^generated/(.*)$": "<rootDir>/../generated/$1"
        },
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
