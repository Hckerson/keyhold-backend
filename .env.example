# Database
DATABASE_URL="postgresql://user:password@localhost:5432/real_estate_db"

# JWT — RS256. Generate a pair with `pnpm keys:generate`.
# Base64-encoded PEM. The private key signs and never leaves the backend;
# the frontend proxy gets JWT_PUBLIC_KEY only, so it can verify but not mint.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_EXPIRATION="24h"

# Stripe (Payment Processing)
STRIPE_API_KEY="sk_test_your_stripe_key_here"
STRIPE_WEBHOOK_SECRET="whsec_test_your_webhook_secret"

# Outbound email over SMTP. Any provider works; Resend's free tier is the
# default here (3,000/month). Host/user/password come from the provider,
# EMAIL_FROM must be an address on a domain you have verified with them.
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASSWORD="re_your_api_key_here"
EMAIL_FROM="noreply@yourdomain.com"

# Cloudinary (Image & Document Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Twilio (SMS + bridged voice calling)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+1234567890"
TWILIO_STATUS_CALLBACK_URL="https://api.example.com/api/webhooks/twilio/voice-status"

# Sentry. Errors are reported only while a DSN is set, so leaving it empty
# keeps local runs out of the project. Sample rate defaults to 0.1.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=""

# Server
PORT=5000
TRUST_PROXY_HOPS=0
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Parent domain for the session cookie, so the web app on keyhol.me can read the
# cookie the API on api.keyhol.me sets. Leave empty locally: localhost already
# shares cookies across ports.
COOKIE_DOMAIN=""

# External sign-in. API_PUBLIC_URL is the API's public base including the
# /api prefix. Register these redirect URIs with each provider:
#   ${API_PUBLIC_URL}/auth/google/callback
#   ${API_PUBLIC_URL}/auth/facebook/callback
#   ${API_PUBLIC_URL}/calendar/google/callback
API_PUBLIC_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Google Calendar sync. Encrypts stored refresh tokens at rest.
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
