{
    "compilerOptions": {
        "paths": {
            "@core/*": ["src/modules/core/*"],
            "@modules/*": ["src/modules/*"],
            "@common/*": ["src/common/*"],
            "@prisma-db/*": ["src/common/database/*"],
            "@generated/*": ["generated/*"]
        },
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "resolvePackageJsonExports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2023",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": false,
        "strictBindCallApply": false,
        "noFallthroughCasesInSwitch": false,
        "types": ["node", "jest"]
    },
    "files": ["src/common/types/express.d.ts"],
    "include": [
        "src/**/*",
        "generated/**/*",
        "test/**/*",
        "prisma/**/*",
        "scripts/**/*"
    ]
}
