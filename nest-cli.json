{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": false,
        "builder": {
            "type": "swc",
            "options": {
                "stripLeadingPaths": false,
                "filenames": ["src", "generated"]
            }
        }
    }
}
