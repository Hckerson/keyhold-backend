// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS - USER DOMAIN
// ============================================================================
enum UserRole {
  ADMIN
  BUYER
  SELLER
}

enum UserAccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
}

// ============================================================================
// ENUMS - REAL ESTATE DOMAIN
// ============================================================================

enum PropertyType {
  ESTATE
  VILLA
  PENTHOUSE
  HOUSE
  APARTMENT
  CONDO
  TOWNHOUSE
  LAND
  OTHER
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  PENDING
  SOLD
  EXPIRED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContactChannel {
  EMAIL
  SMS
  CALL
}

enum ContactDirection {
  OUTBOUND
  INBOUND
}

enum ContactStatus {
  QUEUED
  SENT
  RINGING
  COMPLETED
  NO_ANSWER
  FAILED
}

enum ViewingMode {
  IN_PERSON
  VIRTUAL
  OPEN_HOUSE
}

enum ViewingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
}

enum Contingency {
  INSPECTION
  APPRAISAL
  FINANCING
}

enum MilestoneKind {
  INSPECTION
  APPRAISAL
  FINANCING
  CLOSING
}

enum MilestoneStatus {
  PENDING
  SCHEDULED
  COMPLETED
  WAIVED
}

enum TransactionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationType {
  EMAIL
  PHONE
  KYC
  PASSWORD_RESET
}

enum FlagType {
  USER
  PROPERTY
  MESSAGE
}

enum FlagStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum DisputeStatus {
  OPEN
  PENDING_REVIEW
  RESOLVED
  DISMISSED
}

enum DisputeEvidenceType {
  MESSAGE
  PHOTO
  DOCUMENT
}

enum NotificationType {
  PRICE_DROP
  NEW_LISTING
  UNDER_OFFER
  STATUS_CHANGE
  OFFER_RESPONSE
  VIEWING_CONFIRMATION
  MESSAGE_RECEIVED
  CONNECTION_REQUEST
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum SettingCategory {
  PLATFORM
  COMMERCE
  MODERATION
  AVAILABILITY
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum AuditActionType {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_SUSPENDED
  PROPERTY_CREATED
  PROPERTY_UPDATED
  PROPERTY_DELETED
  PROPERTY_FLAGGED
  TRANSACTION_CREATED
  TRANSACTION_UPDATED
  TRANSACTION_COMPLETED
  OFFER_CREATED
  OFFER_ACCEPTED
  DISPUTE_CREATED
  DISPUTE_RESOLVED
  LOGIN
  LOGOUT
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  PERMISSION_DENIED
  SETTINGS_UPDATED
}

// ============================================================================
// MODELS - ALPHABETICAL ORDER
// ============================================================================

model AuditLog {
  // Scalars
  id         String          @id @default(uuid())
  action     AuditActionType
  entityType String // User, Property, Transaction, etc.
  entityId   String
  changes    String? // JSON diff of changes
  ipAddress  String?
  userAgent  String?

  // Foreign Keys
  requestId String?
  actorId   String?
  actor     User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt DateTime @default(now())

  // Constraints
  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model AuthIdentity {
  // Scalars
  id             String       @id @default(uuid())
  provider       AuthProvider
  providerUserId String
  email          String?

  // Foreign Keys
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@unique([provider, providerUserId])
  @@index([userId])
}

model CalendarConnection {
  // Scalars
  id              String    @id @default(uuid())
  refreshToken    String
  googleEmail     String?
  calendarId      String    @default("primary")
  lastSyncAt      DateTime?
  lastSyncError   String?
  lastSyncErrorAt DateTime?

  // Foreign Keys
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Connection {
  // Scalars
  id String @id @default(uuid())

  // Enums
  status ConnectionStatus @default(PENDING)

  // Foreign Keys
  buyerId    String
  buyer      User     @relation("BuyerConnections", fields: [buyerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User     @relation("SellerConnections", fields: [sellerId], references: [id], onDelete: Cascade)

  // Relations
  messages          Message[]
  viewings          Viewing[]
  offers            Offer[]
  transactions      Transaction[]
  contactActivities ContactActivity[]

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@unique([buyerId, propertyId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model ContactActivity {
  // Scalars
  id              String  @id @default(uuid())
  subject         String?
  body            String?
  providerRef     String?
  durationSeconds Int?

  // Enums
  channel   ContactChannel
  direction ContactDirection @default(OUTBOUND)
  status    ContactStatus    @default(QUEUED)

  // Foreign Keys
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User       @relation("ActorContactActivities", fields: [actorId], references: [id], onDelete: Cascade)

  // Timestamps
  occurredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  // Constraints
  @@index([connectionId, occurredAt])
  @@index([actorId])
  @@index([providerRef])
}

model Dispute {
  // Scalars
  id              String        @id @default(uuid())
  title           String
  description     String
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?

  // Foreign Keys
  initiatorId String
  initiator   User   @relation("DisputeInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)

  // Relations
  evidence     DisputeEvidence[]
  transactions Transaction[]

  // Timestamps
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  // Constraints
  @@index([initiatorId])
  @@index([status])
}

model DisputeEvidence {
  // Scalars
  id      String              @id @default(uuid())
  type    DisputeEvidenceType
  content String // URL or text content
  label   String?

  // Foreign Keys
  disputeId String
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@index([disputeId])
}

model Escrow {
  // Scalars
  id                String       @id @default(uuid())
  amount            Decimal      @db.Decimal(14, 2)
  inspectionEndDate DateTime
  stripeTransferId  String?
  stripeAccountId   String?
  status            EscrowStatus @default(HELD)

  // Relations
  transaction Transaction?

  // Timestamps
  releasedAt DateTime?
  refundedAt DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  // Constraints
  @@index([status])
}

model Flag {
  // Scalars
  id      String     @id @default(uuid())
  type    FlagType
  reason         String
  details        String?
  resolutionNote String?
  status         FlagStatus @default(ACTIVE)

  // Foreign Keys
  targetId  String // Could be userId, propertyId, or messageId depending on type
  creatorId String
  creator   User   @relation("FlagCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  // Timestamps
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  // Constraints
  @@index([targetId])
  @@index([creatorId])
  @@index([status])
  @@index([type])
}

model IdentityDocument {
  // Scalars
  id               String             @id @default(uuid())
  documentType     String // PASSPORT, DRIVERS_LICENSE, ID_CARD
  documentNumber   String
  issuerCountry    String
  documentImageUrl String
  faceImageUrl     String?
  status           VerificationStatus @default(PENDING)
  rejectionReason  String?

  // Foreign Keys
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  verifiedAt DateTime?
  expiresAt  DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  // Constraints
  @@index([userId])
  @@index([status])
}

model Message {
  // Scalars
  id      String  @id @default(uuid())
  content String
  isRead  Boolean @default(false)

  // Foreign Keys
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId   String
  receiver     User       @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  // Relations
  attachments MessageAttachment[]

  // Timestamps
  readAt    DateTime?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  // Constraints
  @@index([connectionId])
  @@index([senderId])
  @@index([receiverId])
}

model MessageAttachment {
  // Scalars
  id        String  @id @default(uuid())
  filename  String
  url       String
  publicId  String?
  mimeType  String
  sizeBytes Int

  // Foreign Keys
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@index([messageId])
}

model Notification {
  // Scalars
  id     String  @id @default(uuid())
  title  String
  body   String
  isRead Boolean @default(false)

  // Enums
  type    NotificationType
  channel NotificationChannel @default(IN_APP)

  // Loose reference to whatever the notification is about
  entityType String?
  entityId   String?

  // Foreign Keys
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  readAt    DateTime?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  // Constraints
  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model NotificationPreference {
  // Scalars
  id      String  @id @default(uuid())
  enabled Boolean @default(true)
  email   Boolean @default(true)
  sms     Boolean @default(false)
  inApp   Boolean @default(true)

  // Enums
  type NotificationType

  // Foreign Keys
  userId String
  user   User   @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@unique([userId, type])
  @@index([userId])
}

model Offer {
  // Scalars
  id               String    @id @default(uuid())
  offeredPrice     Decimal   @db.Decimal(14, 2)
  offeredTerms     String
  responsePrice    Decimal?  @db.Decimal(14, 2)
  responseFeedback String?
  moveInDate       DateTime?
  earnestMoney     Decimal?  @db.Decimal(14, 2)

  // Enums
  status        OfferStatus   @default(PENDING)
  contingencies Contingency[]

  // Foreign Keys
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  offererId      String
  offerer        User       @relation("BuyerOffers", fields: [offererId], references: [id], onDelete: Cascade)
  responseFromId String?
  responseFrom   User?      @relation("SellerOffers", fields: [responseFromId], references: [id], onDelete: SetNull)

  // Relations
  milestones DealMilestone[]

  // Timestamps
  expiresAt   DateTime
  respondedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  // Constraints
  @@index([connectionId])
  @@index([propertyId])
  @@index([offererId])
  @@index([responseFromId])
  @@index([status])
}

model DealMilestone {
  // Scalars
  id               String   @id @default(uuid())
  note             String?
  appraisedValue   Decimal? @db.Decimal(14, 2)
  documentUrl      String?
  documentName     String?
  documentPublicId String?

  // Enums
  kind   MilestoneKind
  status MilestoneStatus @default(PENDING)

  // Foreign Keys
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  // Timestamps
  dueAt       DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  // Constraints
  @@unique([offerId, kind])
  @@index([offerId])
  @@index([status])
}

model PhoneVerification {
  // Scalars
  id       String             @id @default(uuid())
  phone    String
  code     String
  attempts Int                @default(0)
  status   VerificationStatus @default(PENDING)

  // Foreign Keys
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  verifiedAt DateTime?
  expiresAt  DateTime
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  // Constraints
  @@index([userId])
  @@index([phone])
  @@index([status])
}

model PlatformSetting {
  // Scalars
  key   String @id
  value String

  // Enums
  category SettingCategory @default(PLATFORM)

  // Foreign Keys
  updatedById String?
  updatedBy   User?   @relation("SettingUpdates", fields: [updatedById], references: [id], onDelete: SetNull)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@index([category])
}

model Property {
  // Scalars
  id            String    @id @default(uuid())
  title         String
  description   String
  address       String
  locality      String
  region        String
  postalCode    String
  country       String    @default("US")
  latitude      Float?
  longitude     Float?
  price         Decimal   @db.Decimal(14, 2)
  bedrooms      Int
  bathrooms     Int
  sqFt          Float?
  lotSqFt       Float?
  yearBuilt     Int?
  walkScore     Int?
  viewsCount    Int       @default(0)
  featuredUntil DateTime?
  soldAt        DateTime?
  amenities     String[] // JSON array
  features      String[] // JSON array

  // Enums
  type   PropertyType
  status PropertyStatus @default(AVAILABLE)

  // Foreign Keys
  sellerId String
  seller   User   @relation("SellerProperties", fields: [sellerId], references: [id], onDelete: Cascade)

  // Relations
  images       PropertyImage[]
  connections  Connection[]
  viewings     Viewing[]
  offers       Offer[]
  transactions Transaction[]
  savedBy      SavedProperty[]

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@index([sellerId])
  @@index([status])
  @@index([locality])
  @@index([type])
  @@index([price])
  @@index([featuredUntil])
}

model PropertyImage {
  // Scalars
  id       String  @id @default(uuid())
  url      String
  publicId String?
  order    Int

  // Foreign Keys
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@index([propertyId])
}

model Review {
  // Scalars
  id      String  @id @default(uuid())
  rating  Int // 1-5
  comment String?

  // Foreign Keys
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User        @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId    String
  reviewee      User        @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@unique([transactionId, reviewerId])
  @@index([transactionId])
  @@index([reviewerId])
  @@index([revieweeId])
}

model SavedProperty {
  // Scalars
  id String @id @default(uuid())

  // Foreign Keys
  buyerId    String
  buyer      User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@unique([buyerId, propertyId])
  @@index([buyerId])
  @@index([propertyId])
}

model Transaction {
  // Scalars
  id                    String  @id @default(uuid())
  finalPrice            Decimal @db.Decimal(14, 2)
  terms                 String
  agreementDocUrl       String?
  stripePaymentIntentId String?

  // Enums
  status TransactionStatus @default(PENDING)

  // Foreign Keys
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User       @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       User       @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Escrow fields (optional)
  escrowHoldId String? @unique
  escrowHold   Escrow? @relation(fields: [escrowHoldId], references: [id], onDelete: SetNull)

  // Dispute fields (optional)
  disputeId String?
  dispute   Dispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)

  // Relations
  reviews Review[]

  // Timestamps
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  // Constraints
  @@index([connectionId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([propertyId])
  @@index([status])
  @@index([escrowHoldId])
  @@index([disputeId])
}

model User {
  // Scalars
  id String @id @default(uuid())

  fullName       String
  email          String            @unique
  passwordHash   String
  phoneNumber    String?
  avatar         String?
  avatarPublicId String?
  bio            String?
  role           UserRole
  status         UserAccountStatus @default(ACTIVE)
  tier           UserTier          @default(STANDARD)

  // Seller profile
  jobTitle      String?
  agencyName    String?
  licenseNumber String?

  // Verification fields
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  kycVerified   Boolean @default(false)
  kycRejected   Boolean @default(false)

  // Timestamps
  lastActive      DateTime? @default(now())
  tokensValidFrom DateTime?
  deletedAt       DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  // Relations
  propertiesOwned         Property[]               @relation("SellerProperties")
  connections             Connection[]             @relation("BuyerConnections")
  sellerConnections       Connection[]             @relation("SellerConnections")
  sentMessages            Message[]                @relation("SenderMessages")
  receivedMessages        Message[]                @relation("ReceiverMessages")
  viewingsRequested       Viewing[]                @relation("BuyerViewings")
  viewingsProposed        Viewing[]                @relation("SellerViewings")
  offers                  Offer[]                  @relation("BuyerOffers")
  receivedOffers          Offer[]                  @relation("SellerOffers")
  buyerTransactions       Transaction[]            @relation("BuyerTransactions")
  sellerTransactions      Transaction[]            @relation("SellerTransactions")
  givenReviews            Review[]                 @relation("ReviewerReviews")
  receivedReviews         Review[]                 @relation("RevieweeReviews")
  verificationTokens      VerificationToken[]
  phoneVerifications      PhoneVerification[]
  identityDocuments       IdentityDocument[]
  flagsCreated            Flag[]                   @relation("FlagCreator")
  disputesInitiated       Dispute[]                @relation("DisputeInitiator")
  auditLogs               AuditLog[]               @relation("AuditActor")
  savedProperties         SavedProperty[]
  suspensions             UserSuspension[]
  notifications           Notification[]           @relation("UserNotifications")
  notificationPreferences NotificationPreference[] @relation("UserNotificationPreferences")
  settingUpdates          PlatformSetting[]        @relation("SettingUpdates")
  conciergeClients        ConciergeClient[]        @relation("AgentConciergeClients")
  conciergeProfile        ConciergeClient[]        @relation("ConciergeClientProfile")
  conciergeServices       ConciergeService[]       @relation("AgentConciergeServices")
  conciergePractices      ConciergePractice[]      @relation("AgentConciergePractices")
  savedSearches           SavedSearch[]            @relation("BuyerSavedSearches")
  contactActivities       ContactActivity[]        @relation("ActorContactActivities")
  authIdentities          AuthIdentity[]
  calendarConnection      CalendarConnection?

  // Constraints
  @@index([email])
  @@index([status])
  @@index([role])
  @@index([emailVerified])
  @@index([tier])
  @@index([createdAt])
}

model UserSuspension {
  // Scalars
  id       String  @id @default(uuid())
  reason   String
  duration Int? // Duration in days, null for indefinite
  notes    String?

  // Foreign Keys
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  liftedAt  DateTime?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  // Constraints
  @@index([userId])
}

model VerificationToken {
  // Scalars
  id       String             @id @default(uuid())
  token    String             @unique
  code     String?
  attempts Int                @default(0)
  type     VerificationType
  status   VerificationStatus @default(PENDING)

  // Foreign Keys
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  expiresAt  DateTime
  verifiedAt DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  // Constraints
  @@index([userId])
  @@index([token])
  @@index([status])
}

model Viewing {
  // Scalars
  id              String   @id @default(uuid())
  proposedTimes   String[] // JSON array of ISO timestamps
  notes           String?
  durationMinutes Int      @default(30)

  // Enums
  status ViewingStatus @default(PENDING)
  mode   ViewingMode   @default(IN_PERSON)

  // Foreign Keys
  connectionId  String
  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User       @relation("BuyerViewings", fields: [requestedById], references: [id], onDelete: Cascade)
  proposedByid  String
  proposedBy    User       @relation("SellerViewings", fields: [proposedByid], references: [id], onDelete: Cascade)
  confirmedById String?

  // Calendar
  googleEventId String?

  // Timestamps
  confirmedTime DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  // Constraints
  @@index([connectionId])
  @@index([propertyId])
  @@index([requestedById])
  @@index([proposedByid])
}

enum UserTier {
  STANDARD
  PREMIUM
  PLATINUM
}

enum ConciergeTier {
  PREMIUM
  VIP
  PLATINUM
}

enum ConciergeStatus {
  ACQUIRING
  UNDER_CONTRACT
  DIVESTING
  DORMANT
}

enum ConciergeRequestStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ServiceComponent {
  DATABASE
  API
  SEARCH
  STORAGE
  PAYMENTS
}

model ConciergeClient {
  // Scalars
  id String @id @default(uuid())

  budget      Decimal   @db.Decimal(14, 2)
  allocated   Decimal   @default(0) @db.Decimal(14, 2)
  clientSince Int
  nextAction  String?
  lastContact DateTime?

  // Enums
  tier   ConciergeTier   @default(PREMIUM)
  status ConciergeStatus @default(ACQUIRING)

  // Foreign Keys
  agentId  String
  agent    User   @relation("AgentConciergeClients", fields: [agentId], references: [id], onDelete: Cascade)
  clientId String
  client   User   @relation("ConciergeClientProfile", fields: [clientId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  requests ConciergeServiceRequest[]
  coverage ConciergePracticeCoverage[]

  // Constraints
  @@unique([agentId, clientId])
  @@index([agentId])
  @@index([clientId])
  @@index([tier])
  @@index([status])
}

model ConciergeService {
  // Scalars
  id String @id @default(uuid())

  key      String
  label    String
  capacity Int    @default(0)

  // Foreign Keys
  agentId String
  agent   User   @relation("AgentConciergeServices", fields: [agentId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  requests ConciergeServiceRequest[]

  // Constraints
  @@unique([agentId, key])
  @@index([agentId])
}

model ConciergeServiceRequest {
  // Scalars
  id String @id @default(uuid())

  summary  String
  closedAt DateTime?

  // Enums
  status ConciergeRequestStatus @default(OPEN)

  // Foreign Keys
  serviceId String
  service   ConciergeService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientId  String
  client    ConciergeClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Constraints
  @@index([serviceId])
  @@index([clientId])
  @@index([status])
}

model ConciergePractice {
  // Scalars
  id String @id @default(uuid())

  key     String
  label   String
  cadence String

  // Foreign Keys
  agentId String
  agent   User   @relation("AgentConciergePractices", fields: [agentId], references: [id], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  coverage ConciergePracticeCoverage[]

  // Constraints
  @@unique([agentId, key])
  @@index([agentId])
}

model ConciergePracticeCoverage {
  // Scalars
  id String @id @default(uuid())

  // Foreign Keys
  practiceId String
  practice   ConciergePractice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  clientId   String
  client     ConciergeClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())

  // Constraints
  @@unique([practiceId, clientId])
  @@index([practiceId])
  @@index([clientId])
}

model SavedSearch {
  // Scalars
  id String @id @default(uuid())

  name         String
  locality     String?
  minPrice     Decimal? @db.Decimal(14, 2)
  maxPrice     Decimal? @db.Decimal(14, 2)
  minBedrooms  Int?
  minBathrooms Int?
  minSqFt      Int?
  notify       Boolean  @default(true)

  // Enums
  propertyType PropertyType?

  // Foreign Keys
  buyerId String
  buyer   User   @relation("BuyerSavedSearches", fields: [buyerId], references: [id], onDelete: Cascade)

  // Timestamps
  lastRunAt DateTime?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  // Constraints
  @@unique([buyerId, name])
  @@index([buyerId])
}

model ServiceMetric {
  // Scalars
  id String @id @default(uuid())

  route      String
  statusCode Int
  latencyMs  Int
  failed     Boolean @default(false)
  requestId  String?

  // Enums
  component ServiceComponent @default(API)

  // Timestamps
  createdAt DateTime @default(now())

  // Constraints
  @@index([component, createdAt])
  @@index([createdAt])
}

model IdempotencyRecord {
  // Scalars
  key      String @id
  userId   String
  method   String
  path     String
  response String

  // Timestamps
  createdAt DateTime @default(now())

  // Constraints
  @@index([createdAt])
}

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id                   String           @id @default(uuid())
  email                String           @unique
  status               NewsletterStatus @default(PENDING)
  confirmTokenHash     String?          @unique
  confirmExpiresAt     DateTime?
  unsubscribeTokenHash String           @unique
  consentText          String
  source               String
  consentedAt          DateTime
  confirmedAt          DateTime?
  unsubscribedAt       DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
